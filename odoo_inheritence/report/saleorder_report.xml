<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='informations_date']" position="replace">

            <div class="col" name="informations_appointment_date">
                <strong>Appointment Date</strong>
                <div>1234</div>
                <!--                <div t-if="doc.appointment_date" t-field="doc.appointment_date" t-options='{"widget": "date"}'/>-->
                <!--                <div t-else="">-</div>-->
            </div>

        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_remark" class="text-start">Remark</th>
        </xpath>
        <xpath expr="//td[@name='td_quantity']" position="after">
            <td name="td_remark" class="text-start">
                <span t-field="line.remark_line"/>
            </td>
        </xpath>


    </template>

</odoo>