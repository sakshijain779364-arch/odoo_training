<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_property_offer_list" model="ir.ui.view">
        <field name="name">property.offer.list</field>
        <field name="model">property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
                <button name="action_accept" string="Accept" type="object" class="fa fa-check btn-success" icon="fa-check" title="Accept"/>
                <button name="action_refuse" string="Refuse" type="object" class="fa fa-times btn-danger" icon="fa-times" title="Refuse"/>
            </list>
        </field>
    </record>
    <record id="action_property_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">property.offer</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Offers !
            </p>
        </field>
    </record>
</odoo>