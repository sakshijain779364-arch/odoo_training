<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_property_type_list" model="ir.ui.view">
        <field name="name">property.type.list</field>
        <field name="model">property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_property_type_forms" model="ir.ui.view">
        <field name="name">property.type.form</field>
        <field name="model">property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                     <field name="property_ids">
                    <list>
                        <field name="name"/>
                        <field name="expected_price"/>
                        <field name="state"/>
                    </list>
                </field>
                </sheet>

            </form>

        </field>
    </record>
    <record id="action_property_type" model="ir.actions.act_window">
        <field name="name">Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">property.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Type !
            </p>
        </field>
    </record>

</odoo>