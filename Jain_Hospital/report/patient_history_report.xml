<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_patient_history" model="ir.actions.report">
        <field name="name">Patient History</field>
        <field name="model">hospital.patient</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">Jain_Hospital.patient_history_report</field>
        <field name="report_file">Jain_Hospital.patient_history_report</field>
        <field name="binding_model_id" ref="Jain_Hospital.model_hospital_patient"/>
        <field name="binding_type">report</field>
    </record>
    <template id="patient_history_report">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>

                    <h2 class="mt-4 mb-4 text-dark font-weight-bold" style="border-bottom: 2px solid #714B67; padding-bottom: 10px;">
                        Patient History
                    </h2>

                    <div class="card p-3 mb-4" style="border-radius: 10px; border: 1px solid #cccccc; background-color: #f8f9fa;">
                        <div class="row">
                            <div class="col-6 mb-2">
                                <strong>Patient Name:</strong>
                                <span t-field="o.name"/>
                            </div>
                            <div class="col-6 mb-2">
                                <strong>Patient Number:</strong>
                                <span t-field="o.patient_sequence"/>
                            </div>
                            <div class="col-6 mb-2">
                                <strong>Appointment Count:</strong>
                                <span t-field="o.appointment_count"/>
                            </div>
                             <div class="col-6 mb-2">
                                <strong>Age:</strong>
                                <span t-field="o.age"/>
                            </div>
                             <div class="col-6 mb-2">
                                <strong>Gender:</strong>
                                <span t-field="o.gender"/>
                            </div>
                             <div class="col-6 mb-2">
                                <strong>Date of Birth:</strong>
                                <span t-field="o.date_of_birth"/>
                             </div>
                             <div class="col-6 mb-2">
                                <strong>Status:</strong>
                                <span t-field="o.state"/>
                            </div>
                             <div class="col-6 mb-2">
                                <strong>Appointment Line:</strong>
                                <span t-field="o.appointment_line"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </t>
    </template>
</odoo>
