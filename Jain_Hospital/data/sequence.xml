<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
    <record id="appointment_numbers" model="ir.sequence">
         <field name="name">Hospital Appointment Sequence</field>
         <field name="code">hospital.appointment</field>
         <field name="prefix">JH/APT/</field>
         <field name="padding">6</field>
         <field name="company_id" eval="False"/>
     </record>

    <record id="patient_numbers" model="ir.sequence">
         <field name="name">Hospital Patient Sequence</field>
         <field name="code">hospital.patient</field>
         <field name="prefix">JH/PPT/</field>
         <field name="padding">6</field>
         <field name="company_id" eval="False"/>
     </record>
    </data>
</odoo>