<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_cancel_appointment_form" model="ir.ui.view">
        <field name="name">cancel.appointment.form</field>
        <field name="model">cancel.appointment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="appointment_id" invisible="context.get('hide.appointment:1')"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="date_cancel"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_cancel" string="Cancel Appointment" type="object" class="btn-secondary"
                            data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hospital_cancel_appointment" model="ir.actions.act_window">
        <field name="name">Cancel Appointment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cancel.appointment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Cancel Appointment!
            </p>

        </field>
    </record>
</odoo>